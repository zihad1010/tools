{
  "name": "tools",
  "main": "src/index.js",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker runs first for the API and for the protected dashboard folder.
    "run_worker_first": ["/api/*", "/dashboard", "/dashboard/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "student-tools-db",
      "database_id": "9b6c1057-9957-4200-af34-b54512b0aaca"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "SESSION_SECRET",
      "store_id": "c2b9d6df9ee2438c9a3f0cdca1c21d88",
      "secret_name": "SESSION_SECRET"
    }
  ]
}
